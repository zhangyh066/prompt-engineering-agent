# Local development defaults. Never commit real credentials.
PEA_DEFAULT_PROVIDER=openai
PEA_REQUEST_TIMEOUT_SECONDS=30
PEA_MAX_RETRIES=2
PEA_RETRY_BASE_DELAY_SECONDS=0.2
PEA_RETRY_MAX_DELAY_SECONDS=2
PEA_MAX_CALLS=100
PEA_LITELLM_LOCAL_MODEL_COST_MAP=True
PEA_LOG_LEVEL=INFO
PEA_DATABASE_PATH=data/pea.db
PEA_ENABLE_REAL_PROVIDERS=False
PEA_TRUSTED_HOSTS=127.0.0.1,localhost,testserver

# Optional between-call cost limit. Unknown provider costs cannot be preempted.
# PEA_COST_BUDGET_USD=1.00

# OpenAI: required only when PEA_DEFAULT_PROVIDER=openai or per-request provider=openai.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional OpenAI-compatible endpoint; no credentials in the URL.
OPENAI_API_BASE=

# Anthropic: required only when selected.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
